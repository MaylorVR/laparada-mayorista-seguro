{
  "name": "mayorista-seguro",
  "version": "1.0.0",
  "description": "Sistema de gestión del traslado ordenado de La Parada al Mercado Mayorista de Santa Anita: padrón de comerciantes, estiba formal con tarifas transparentes, reservas de descarga, inspecciones sanitarias y denuncias anónimas.",
  "main": "src/servidor.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch src/servidor.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml \"tests/**/*.test.js\"",
    "build": "node scripts/build-check.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pg-mem": "^3.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supertest": "^7.1.4"
  }
}
